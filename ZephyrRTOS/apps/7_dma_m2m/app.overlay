&usart1 {
    status = "okay";
    pinctrl-0 = <&usart1_tx_pa9 &usart1_rx_pa10>;
    pinctrl-names = "default";
    current-speed = <115200>;
};

&red_led_4 {
    gpios = <&gpiog 14 GPIO_ACTIVE_LOW>;
};

&dma1
{
    status = "okay";
};

&dma2
{
    status = "okay";
};

/ {
    aliases {
        led1 = &red_led_4;
        led2 = &custom_led1;
        stlink-uart = &usart1;
        my-dma = &dma2;
    };

    leds {
        compatible = "gpio-leds";        

        custom_led1: custom_led1 {
            label = "External LED1";
            gpios = <&gpioa 4 0>;
        };        
    };

	gpio_keys {
		compatible = "gpio-keys";

		button2: button2{
			label = "User_btn2";
			gpios = <&gpioc 2 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};    

};