&usart1 {
    current-speed = <9600>;
    interrupts = <37 2>;
};
&red_led_4 {
    gpios = <&gpiog 14 GPIO_ACTIVE_LOW>;
};
/ {
    aliases {
        led1 = &red_led_4;
        led2 = &custom_led1;
        stlink-uart = &usart1;
    };

    leds {
        compatible = "gpio-leds";        

        custom_led1: custom_led1 {
            label = "External LED1";
            gpios = <&gpioa 4 0>;
        };        
    };

	gpio_keys {
		compatible = "gpio-keys";

		button2: button2{
			label = "User_btn2";
			gpios = <&gpioc 2 GPIO_ACTIVE_LOW>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};    

};