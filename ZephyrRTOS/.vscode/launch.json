{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/apps/1_blinky/build/zephyr/zephyr.elf",
            "name": "Debug STM32F429ZI with OpenOCD",
            "request": "launch",
            "type": "cortex-debug",
            "preLaunchTask": "Start OpenOCD Server",
            "servertype": "external",
            "gdbTarget": "localhost:3333",
            "showDevDebugTimestamps": true,
            "debuggerArgs": ["-q", "--interpreter=mi2"],
            "gdbPath": "arm-none-eabi-gdb.exe",
            // "gdbPath": "D:/zephyr-3.6.0/zephyr-sdk-0.16.8/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb.exe",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "searchDir": [
                "${workspaceFolder}",
                "C:/openocd/xpack-openocd-0.12.0-3/share/openocd/scripts"
            ],
            "showDevDebugOutput": "parsed",
            "device": "STM32F429ZI",
            "interface": "swd",
            "runToEntryPoint": "main",
            "breakAfterReset": true,
            "numberOfProcessors": 1,
            // "objdumpPath": "D:/zephyr-3.6.0/zephyr-sdk-0.16.8/arm-zephyr-eabi/bin/arm-zephyr-eabi-objdump.exe",
            "postDebugTask": "Stop OpenOCD Server"
        },
        {
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/apps/1_blinky/build/zephyr/zephyr.elf",
            "name": "Debug STM32F429ZI with Internal OpenOCD",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "C:/openocd/xpack-openocd-0.12.0-3/bin/openocd.exe",
            "gdbPath": "D:/zephyr-3.6.0/zephyr-sdk-0.16.8/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb.exe",
            "configFiles": [
                "interface/stlink.cfg",
                "target/stm32f4x.cfg"
            ],
            "searchDir": [
                "${workspaceFolder}",
                "C:/openocd/xpack-openocd-0.12.0-3/share/openocd/scripts"
            ],
            "showDevDebugOutput": "parsed",
            "device": "STM32F429ZI",
            "interface": "swd",
            "runToEntryPoint": "main",
            "breakAfterReset": true,
            "objdumpPath": "D:/zephyr-3.6.0/zephyr-sdk-0.16.8/arm-zephyr-eabi/bin/arm-zephyr-eabi-objdump.exe"
        }
    ]
}