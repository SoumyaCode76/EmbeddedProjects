{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/Debug/LTDC_VSCode_Example.elf",
            "name": "Debug STM32F429ZI with OpenOCD",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "C:/openocd/xpack-openocd-0.12.0-3/bin/openocd.exe",
            "configFiles": [
                "openocd_stm32f429zi.cfg"
            ],
            "searchDir": [
                "${workspaceFolder}",
                "C:/openocd/xpack-openocd-0.12.0-3/share/openocd/scripts"
            ],
            "runToEntryPoint": "main",
            "showDevDebugOutput": "parsed",
            "device": "STM32F429ZI",
            "interface": "swd",
            "svdFile": "${workspaceFolder}/STM32F429.svd",
            "preLaunchTask": "Build"
        }
    ]
}