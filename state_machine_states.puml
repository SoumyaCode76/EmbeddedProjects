@startuml State Machine Internal States

!define LIGHTBLUE #E1F5FE
!define LIGHTGREEN #E8F5E8
!define LIGHTYELLOW #FFF8E1
!define LIGHTPINK #FCE4EC
!define LIGHTGRAY #F5F5F5

title Individual State Machine State Diagrams

state "State Machine Task 1 (Communication Handler)" as SM1 {
    [*] --> IDLE : System Init
    IDLE : Waiting for external input
    IDLE --> RECEIVING : UART RX Interrupt
    RECEIVING : Receiving data packet
    RECEIVING --> PROCESSING : Complete packet received
    RECEIVING --> ERROR : Timeout/Invalid data
    PROCESSING : Validating and parsing data
    PROCESSING --> RESPONDING : Data valid
    PROCESSING --> ERROR : Data invalid
    RESPONDING : Sending response
    RESPONDING --> IDLE : Response sent
    ERROR : Handle communication error
    ERROR --> IDLE : Error cleared
    ERROR --> ERROR : Retry on persistent error
}

state "State Machine Task 2 (Sensor Controller)" as SM2 {
    [*] --> INIT : System Init
    INIT : Initialize sensor interface
    INIT --> IDLE : Initialization complete
    IDLE : Waiting for measurement cycle
    IDLE --> MEASURING : Timer trigger (periodic)
    MEASURING : Reading sensor data
    MEASURING --> VALIDATING : Raw data acquired
    MEASURING --> ERROR : Sensor communication failed
    VALIDATING : Checking data integrity
    VALIDATING --> TRANSMITTING : Data valid
    VALIDATING --> ERROR : Data out of range
    TRANSMITTING : Send data to other tasks
    TRANSMITTING --> IDLE : Data transmitted
    ERROR : Handle sensor error
    ERROR --> INIT : Critical error - reinitialize
    ERROR --> IDLE : Minor error - retry next cycle
}

state "State Machine Task 3 (System Monitor)" as SM3 {
    [*] --> MONITORING : System Init
    MONITORING : Checking system health
    MONITORING --> MONITORING : All systems normal
    MONITORING --> WARNING : Resource threshold exceeded
    MONITORING --> CRITICAL : Critical system failure
    WARNING : Log warning and take corrective action
    WARNING --> MONITORING : Issue resolved
    WARNING --> CRITICAL : Issue escalated
    CRITICAL : Emergency system response
    CRITICAL --> RECOVERY : Attempting recovery
    CRITICAL --> SHUTDOWN : Recovery failed
    RECOVERY : Executing recovery procedures
    RECOVERY --> MONITORING : Recovery successful
    RECOVERY --> SHUTDOWN : Recovery failed
    SHUTDOWN : Safe system shutdown
    SHUTDOWN --> [*] : System halted
}

note top of SM1 : Reactive to external events\n(UART interrupts, GPIO changes)
note top of SM2 : Timer-driven periodic execution\n(Sensor sampling every 100ms)
note top of SM3 : Continuous monitoring\n(System health checks)

note bottom : Round-robin scheduler gives each\nstate machine 10ms time slices

@enduml