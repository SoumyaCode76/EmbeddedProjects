
#define MADCTL_MY 0x80  ///< Bottom to top
#define MADCTL_MX 0x40  ///< Right to left
#define MADCTL_MV 0x20  ///< Reverse Mode
#define MADCTL_ML 0x10  ///< LCD refresh Bottom to top
#define MADCTL_RGB 0x00 ///< Red-Green-Blue pixel order
#define MADCTL_BGR 0x08 ///< Blue-Green-Red pixel order
#define MADCTL_MH 0x04  ///< LCD refresh right to left

#include "ili9341_reg.h"
#include "main.h"
#include "spi.h"
#include <stdlib.h>

static void delay_50ms(void){
	//for(uint32_t i = 0 ; i<(0xFFFFU * 10U);i++);
	HAL_Delay(50);
}

/* 
 *ILI9341 TFT-LCD configuration commands 
 *Use this command list with MCU(like STM32F429 DISC board) which uses RGB interface to communicate with the LCD
 */

void LCD_Pin_Config(void)
{
	GPIO_InitTypeDef LCD_Pins_Init = {0};
	// Configure pins for CSX (PC2 as GPIO Output, ACTIVE HIGH)
	__HAL_RCC_GPIOC_CLK_ENABLE();
	LCD_Pins_Init.Pin = GPIO_PIN_2;
	LCD_Pins_Init.Mode = GPIO_MODE_OUTPUT_PP;
	LCD_Pins_Init.Speed = GPIO_SPEED_HIGH;
	HAL_GPIO_Init(GPIOC, &LCD_Pins_Init);

	memset((void *)&LCD_Pins_Init, 0, sizeof(GPIO_InitTypeDef));

	// Configure pin for DCX (PD13)
	__HAL_RCC_GPIOD_CLK_ENABLE();
	LCD_Pins_Init.Pin = GPIO_PIN_13;
	LCD_Pins_Init.Mode = GPIO_MODE_OUTPUT_PP;
	LCD_Pins_Init.Speed = GPIO_SPEED_HIGH;
	HAL_GPIO_Init(GPIOD, &LCD_Pins_Init);

	memset((void *)&LCD_Pins_Init, 0, sizeof(GPIO_InitTypeDef));

	// Configure pin for RDX (PD12)
	__HAL_RCC_GPIOD_CLK_ENABLE();
	LCD_Pins_Init.Pin = GPIO_PIN_12;
	LCD_Pins_Init.Mode = GPIO_MODE_OUTPUT_PP;
	LCD_Pins_Init.Speed = GPIO_SPEED_HIGH;
	HAL_GPIO_Init(GPIOD, &LCD_Pins_Init);

	memset((void *)&LCD_Pins_Init, 0, sizeof(GPIO_InitTypeDef));

	// Configure pin for Data Enable
	__HAL_RCC_GPIOF_CLK_ENABLE();
	LCD_Pins_Init.Pin = GPIO_PIN_10;
	LCD_Pins_Init.Mode = GPIO_MODE_OUTPUT_PP;
	LCD_Pins_Init.Speed = GPIO_SPEED_HIGH;
	HAL_GPIO_Init(GPIOF, &LCD_Pins_Init);

	memset((void *)&LCD_Pins_Init, 0, sizeof(GPIO_InitTypeDef));

	// Configure pin for RESX
	__HAL_RCC_GPIOA_CLK_ENABLE();
	LCD_Pins_Init.Pin = GPIO_PIN_7;
	LCD_Pins_Init.Mode = GPIO_MODE_OUTPUT_PP;
	LCD_Pins_Init.Speed = GPIO_SPEED_HIGH;
	HAL_GPIO_Init(GPIOA, &LCD_Pins_Init);

	memset((void *)&LCD_Pins_Init, 0, sizeof(GPIO_InitTypeDef));

}

void LCD_Pin_Init(void)
{
	// Set CSX to HIGH (inactive - chip not selected)
	HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_SET);
	// Set DCX to HIGH
	HAL_GPIO_WritePin(GPIOD, GPIO_PIN_13, GPIO_PIN_SET);
	// Set DE to LOW
	HAL_GPIO_WritePin(GPIOF, GPIO_PIN_10, GPIO_PIN_RESET);
	// Set RESX to HIGH
	HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_SET);
}

void LCD_Write_Cmd(uint8_t cmd)
{
	hspi5.Instance->CR1 |= (1U << 14);
	HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_RESET);	// Chip select assert to LOW
	HAL_GPIO_WritePin(GPIOD, GPIO_PIN_13, GPIO_PIN_RESET);	// Set DCX line to LOW for command input
	HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, GPIO_PIN_SET);	// Set RDX line to HIGH
	HAL_SPI_Transmit(&hspi5, &cmd, sizeof(cmd), HAL_MAX_DELAY);		// Transmit command byte
	HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_SET);		// Chip select de-assert to HIGH
}

void LCD_Write_Data(uint8_t * data, uint16_t length)
{
	hspi5.Instance->CR1 |= (1U << 14);
	HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_RESET);	// Chip select assert to LOW
	HAL_GPIO_WritePin(GPIOD, GPIO_PIN_13, GPIO_PIN_SET);	// Set DCX line to HIGH for parameter input
	for(uint16_t i = 0; i < length; i++)
	{
		HAL_SPI_Transmit(&hspi5, (uint8_t *)&data[i], sizeof(data[i]), HAL_MAX_DELAY);		// Transmit parameter byte
	}
	HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_SET);		// Chip select de-assert to HIGH
}

void LCD_Read_Data(uint8_t cmd, uint8_t * read_data, uint16_t length)
{
	HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_RESET);						// Chip select assert to LOW
	HAL_GPIO_WritePin(GPIOD, GPIO_PIN_13, GPIO_PIN_RESET);						// Set DCX line to LOW for command input
	HAL_GPIO_WritePin(GPIOD, GPIO_PIN_12, GPIO_PIN_SET);						// Set RDX line to HIGH for command input
	hspi5.Instance->CR1 |= (1U << 14);											// Change BIDIOE to Transmit only
	HAL_SPI_Transmit(&hspi5, &cmd, sizeof(cmd), HAL_MAX_DELAY);					// Transmit command byte
	hspi5.Instance->CR1 &= ~(1U << 14);											// Change BIDIOE to Receive only
	HAL_GPIO_WritePin(GPIOD, GPIO_PIN_13, GPIO_PIN_SET);						// Set DCX line to HIGH for parameter input
	for(uint16_t i = 0; i < length; i++)
	{
		HAL_SPI_Receive(&hspi5, &read_data[i], 1, HAL_MAX_DELAY);
	}
	HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_SET);							// Chip select assert to HIGH
}

void LCD_Config(void)
{
	/* array to hold the command parameters*/
	uint8_t params[15] = {0};

	LCD_Write_Cmd(ILI9341_SWRESET);
	LCD_Write_Cmd(ILI9341_POWERB);
	params[0] = 0x00;
	params[1] = 0xD9;
	params[2] = 0x30;
	LCD_Write_Data(params, 3);

	LCD_Write_Cmd(ILI9341_POWER_SEQ);
	params[0]= 0x64;
	params[1]= 0x03;
	params[2]= 0X12;
	params[3]= 0X81;
	LCD_Write_Data(params, 4);

	LCD_Write_Cmd(ILI9341_DTCA);
	params[0]= 0x85;
	params[1]= 0x10;
	params[2]= 0x7A;
	LCD_Write_Data(params, 3);

	LCD_Write_Cmd(ILI9341_POWERA);
	params[0]= 0x39;
	params[1]= 0x2C;
	params[2]= 0x00;
	params[3]= 0x34;
	params[4]= 0x02;
	LCD_Write_Data(params, 5);

	LCD_Write_Cmd(ILI9341_PRC);
	params[0]= 0x20;
	LCD_Write_Data(params, 1);

	LCD_Write_Cmd(ILI9341_DTCB);
	params[0]= 0x00;
	params[1]= 0x00;
	LCD_Write_Data(params, 2);

	LCD_Write_Cmd(ILI9341_POWER1);
	params[0]= 0x1B;
	LCD_Write_Data(params, 1);

	LCD_Write_Cmd(ILI9341_POWER2);
	params[0]= 0x12;
	LCD_Write_Data(params, 1);

	LCD_Write_Cmd(ILI9341_VCOM1);
	params[0]= 0x08;
	params[1]= 0x26;
	LCD_Write_Data(params, 2);

	LCD_Write_Cmd(ILI9341_VCOM2);
	params[0]= 0XB7;
	LCD_Write_Data(params, 1);

	uint8_t m;
	m = MADCTL_MV | MADCTL_MY| MADCTL_BGR;

	LCD_Write_Cmd(ILI9341_MAC);    // Memory Access Control <Landscape setting>
	params[0]= m;
	LCD_Write_Data(params, 1);

	LCD_Write_Cmd(ILI9341_PIXEL_FORMAT);
	params[0]= 0x55; //select RGB565
	LCD_Write_Data(params, 1);

	LCD_Write_Cmd(ILI9341_FRMCTR1);
	params[0]= 0x00;
	params[1]= 0x1B;//frame rate = 70
	LCD_Write_Data(params, 2);

	LCD_Write_Cmd(ILI9341_DFC);    // Display Function Control
	params[0]= 0x0A;
	params[1]= 0xA2;
	LCD_Write_Data(params, 2);

	LCD_Write_Cmd(ILI9341_3GAMMA_EN);    // 3Gamma Function Disable
	params[0]= 0x02;
	LCD_Write_Data(params, 1);

	LCD_Write_Cmd(ILI9341_GAMMA);
	params[0]= 0x01;
	LCD_Write_Data(params, 1);

	LCD_Write_Cmd(ILI9341_PGAMMA);    //Set Gamma
	params[0]= 0x0F;
	params[1]= 0x1D;
	params[2]= 0x1A;
	params[3]= 0x0A;
	params[4]= 0x0D;
	params[5]= 0x07;
	params[6]= 0x49;
	params[7]= 0X66;
	params[8]= 0x3B;
	params[9]= 0x07;
	params[10]= 0x11;
	params[11]= 0x01;
	params[12]= 0x09;
	params[13]= 0x05;
	params[14]= 0x04;
	LCD_Write_Data(params, 15);

	LCD_Write_Cmd(ILI9341_NGAMMA);
	params[0]= 0x00;
	params[1]= 0x18;
	params[2]= 0x1D;
	params[3]= 0x02;
	params[4]= 0x0F;
	params[5]= 0x04;
	params[6]= 0x36;
	params[7]= 0x13;
	params[8]= 0x4C;
	params[9]= 0x07;
	params[10]= 0x13;
	params[11]= 0x0F;
	params[12]= 0x2E;
	params[13]= 0x2F;
	params[14]= 0x05;
	LCD_Write_Data(params, 15);

	LCD_Write_Cmd(ILI9341_RASET); //page address set
	params[0]= 0x00;
	params[1]= 0x00;
	params[2]= 0x00;
	params[3]= 0xf0; //240 rows = 0xf0
	LCD_Write_Data(params, 4);

	LCD_Write_Cmd(ILI9341_CASET);
	params[0]= 0x00;
	params[1]= 0x00;
	params[2]= 0x01;
	params[3]= 0x40; //320 columns = 0x140
	LCD_Write_Data(params, 4);

	LCD_Write_Cmd(ILI9341_RGB_INTERFACE);
	params[0] = 0xC2; //Data is fetched during falling edge of DOTCLK
	LCD_Write_Data(params, 1);

	LCD_Write_Cmd(ILI9341_INTERFACE);
	params[0] = 0x00;
	params[1] = 0x00;
	params[2] = 0x06;
	LCD_Write_Data(params, 3);

	LCD_Write_Cmd(ILI9341_SLEEP_OUT); //Exit Sleep
	delay_50ms();
	delay_50ms();
	LCD_Write_Cmd(ILI9341_DISPLAY_ON); //display on

}
